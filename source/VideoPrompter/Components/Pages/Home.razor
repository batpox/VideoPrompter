@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="toolbar">
 <strong>VideoPrompter</strong>
 <button @onclick="Toggle" disabled="@(!_running && _speechEngine != "browser")">@(_running ? "Stop" : "Start")</button>
 <button @onclick="() => _editing = !_editing">Script</button>
 <button @onclick="Reset">Reset</button>
 <button @onclick="() => _settings = !_settings">Settings</button>
 <button @onclick="ExportSrt" title="Download captions from finalized speech recognition">Export SRT</button>
 <label>Text <input aria-label="Font size" type="range" min="20" max="68" @bind="_fontSize" @bind:event="oninput" /></label>
 <label><input type="checkbox" @bind="_mirror" /> Mirror</label>
 <span class="status">@_status</span>
</div>
@if (_settings)
{
 <div class="settings">
  <div><strong>Speech Source:</strong> <select aria-label="Speech recognition source" @bind="_speechEngine" @bind:after="SaveSpeechEngine" disabled="@_running"><option value="browser">Browser Speech Recognition (Edge / Chrome)</option><option value="local">Local Speech Engine (planned)</option></select></div>
  <small>@(_speechEngine == "browser" ? "Browser recognition may send microphone audio to a cloud service." : "Local recognition is not implemented yet. Choose Browser to start recording.")</small>
  <div><strong>Text Folder:</strong> @(_textFolder.Length==0 ? "Not selected" : _textFolder) <button @onclick="ChooseTextFolder">Choose Folder</button></div>
  <div><strong>SRT Folder:</strong> @(_srtFolder.Length==0 ? (_textFolder.Length==0 ? "Default browser downloads" : "Same as text folder") : _srtFolder) <button @onclick="ChooseSrtFolder">Choose Folder</button> <button @onclick="ClearSrtFolder">Use Text Folder</button></div>
  @if (_textFiles.Length>0)
  {
   <div><label for="textFile">Text File:</label> <select id="textFile" @bind="_selectedFile"><option value="">Select a file</option>@foreach(var file in _textFiles){<option value="@file">@file</option>}</select> <button @onclick="LoadSelectedFile" disabled="@string.IsNullOrEmpty(_selectedFile)">Load Text File</button></div>
  }
  <small>Choose a folder containing .txt or .md scripts. SRT files save to the text folder when no SRT folder is selected. Browser permission may be requested again after reopening.</small>
 </div>
}
@if (_editing)
{
 <div class="editor"><textarea aria-label="Script" @bind="_script"></textarea><button @onclick="ApplyScript">Load Script</button></div>
}
<div class="prompter @(_mirror?"mirror":"")" style="font-size:@(_fontSize)px" id="scriptPanel">
 @for(var i=0;i<_tracker.Count;i++)
 {
   var n=i;
   <span id="@($"word-{i}")" class="word @(i<_tracker.Position?"past":i==_tracker.Position?"current":"")" @onclick="()=>Seek(n)">@_tracker.DisplayWords[i]</span>
 }
</div>
<div class="footer"><span>@_tracker.Position / @_tracker.Count words</span><span>Microphone stays on this device · Resize this window beside OBS</span></div>
@code {
 private readonly ScriptTracker _tracker=new();
 private readonly ScriptTracker _captionTracker=new();
 private string _script="Welcome to VideoPrompter. As you speak, the text follows your words. Pause and the script pauses with you.";
 private bool _editing=true,_running,_mirror,_settings;
 private string _textFolder="",_srtFolder="",_selectedFile="";
 private string _speechEngine="browser";
 private string[] _textFiles=[];
 private bool _interactiveReady;
 private int _fontSize=36;
 private string _status="Ready";
 private DotNetObjectReference<Home>? _reference;
 protected override void OnInitialized(){_tracker.Load(_script);_captionTracker.Load(_script);}
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
   if(firstRender)
   {
     _reference=DotNetObjectReference.Create(this);
     _interactiveReady=true;
     await JS.InvokeVoidAsync("videoPrompter.initializeFolders",_reference);
     _speechEngine=await JS.InvokeAsync<string>("videoPrompter.getSpeechEngine");
     await InvokeAsync(StateHasChanged);
   }
 }
 private async Task SaveSpeechEngine()=>await JS.InvokeVoidAsync("videoPrompter.setSpeechEngine",_speechEngine);
 private async Task Toggle()
 {
   if(_running){await JS.InvokeVoidAsync("videoPrompter.stop");_running=false;_status="Stopped";}
   else {try{if(_speechEngine!="browser"){_status="Local speech recognition is not implemented yet.";return;}_captionTracker.Load(_script);_captionTracker.Seek(_tracker.Position);await JS.InvokeVoidAsync("videoPrompter.start",_reference,_speechEngine);_running=true;_editing=false;_status="Listening";}catch(Exception ex){_status=ex.Message;}}
 }
 private Task ChooseTextFolder()=>ChooseFolder("text");
 private Task ChooseSrtFolder()=>ChooseFolder("srt");
 private async Task ChooseFolder(string kind)
 {
  try{await JS.InvokeVoidAsync("videoPrompter.selectFolder",kind);}
  catch(Exception ex){_status="Folder selection: "+ex.Message;}
 }
 private async Task ClearSrtFolder()
 {
  try{await JS.InvokeVoidAsync("videoPrompter.clearSrtFolder");}
  catch(Exception ex){_status="Folder selection: "+ex.Message;}
 }
 private async Task LoadSelectedFile()
 {
  try
  {
   _script=await JS.InvokeAsync<string>("videoPrompter.loadTextFile",_selectedFile);
   await ApplyScript();
   _status="Loaded "+_selectedFile;
  }
  catch(Exception ex){_status="Text file: "+ex.Message;}
 }
 [JSInvokable]
 public Task OnFoldersChanged(string textFolder,string srtFolder,string[] files)
 {
  _textFolder=textFolder;_srtFolder=srtFolder;_textFiles=files;
  if(!files.Contains(_selectedFile))_selectedFile="";
  return InvokeAsync(StateHasChanged);
 }
 [JSInvokable]
 public Task OnFolderError(string message)
 {
  _status="Folders: "+message;
  return InvokeAsync(StateHasChanged);
 }
 private async Task ExportSrt()=>await JS.InvokeVoidAsync("videoPrompter.exportSrt");
 private async Task ApplyScript(){_tracker.Load(_script);_captionTracker.Load(_script);_editing=false;await JS.InvokeVoidAsync("videoPrompter.clearCaptions");}
 private async Task Reset(){_tracker.Seek(0);_captionTracker.Seek(0);await JS.InvokeVoidAsync("videoPrompter.scrollTo",0);}
 private async Task Seek(int i){_tracker.Seek(i);_captionTracker.Seek(i);await JS.InvokeVoidAsync("videoPrompter.scrollTo",i);}
 [JSInvokable]
 public async Task OnTranscript(string text,bool isFinal)
 {
   if(!_running)return;
   _tracker.Match(text);
   _status=isFinal?"Listening": "Recognizing";
   await InvokeAsync(StateHasChanged);
   await JS.InvokeVoidAsync("videoPrompter.scrollTo",_tracker.Position);
 }
 [JSInvokable]
 public Task<string[]> OnFinalCaption(string transcript)
 {
   if(!_running || string.IsNullOrWhiteSpace(transcript))return Task.FromResult(Array.Empty<string>());
   var start=_captionTracker.Position;
   var end=_captionTracker.Match(transcript);
   var spokenCount=System.Text.RegularExpressions.Regex.Matches(transcript,@"[\p{L}\p{N}']+").Count;
   if(end<=start)return Task.FromResult(Array.Empty<string>());
   // A large jump likely means the speaker skipped part of the script.
   // Move the cursor but do not insert unspoken intervening words into subtitles.
   if(end-start>spokenCount+3)return Task.FromResult(Array.Empty<string>());
   return Task.FromResult(_captionTracker.DisplayWords.Skip(start).Take(end-start).ToArray());
 }
 [JSInvokable]
 public Task OnStatus(string text){_status=text;return InvokeAsync(StateHasChanged);}
 public async ValueTask DisposeAsync()
 {
   try
   {
     // Prerendered components are disposed before JavaScript interop becomes available.
     if(_interactiveReady && _running)
       await JS.InvokeVoidAsync("videoPrompter.stop");
   }
   catch(JSDisconnectedException) { }
   catch(InvalidOperationException) { } // Circuit is no longer interactive.
   finally
   {
     _reference?.Dispose();
   }
 }
}