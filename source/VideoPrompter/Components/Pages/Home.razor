@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="toolbar">
 <strong>VideoPrompter</strong>
 <button @onclick="Toggle">@(_running ? "Stop" : "Start")</button>
 <button @onclick="() => _editing = !_editing">Script</button>
 <button @onclick="Reset">Reset</button>
 <label>Text <input aria-label="Font size" type="range" min="20" max="68" @bind="_fontSize" @bind:event="oninput" /></label>
 <label><input type="checkbox" @bind="_mirror" /> Mirror</label>
 <span class="status">@_status</span>
</div>
@if (_editing)
{
 <div class="editor"><textarea aria-label="Script" @bind="_script"></textarea><button @onclick="ApplyScript">Load Script</button></div>
}
<div class="prompter @(_mirror?"mirror":"")" style="font-size:@(_fontSize)px" id="scriptPanel">
 @for(var i=0;i<_tracker.Count;i++)
 {
   var n=i;
   <span id="@($"word-{i}")" class="word @(i<_tracker.Position?"past":i==_tracker.Position?"current":"")" @onclick="()=>Seek(n)">@_tracker.DisplayWords[i] </span>
 }
</div>
<div class="footer"><span>@_tracker.Position / @_tracker.Count words</span><span>Microphone stays on this device · Resize this window beside OBS</span></div>
@code {
 private readonly ScriptTracker _tracker=new();
 private string _script="Welcome to VideoPrompter. As you speak, the text follows your words. Pause and the script pauses with you.";
 private bool _editing=true,_running,_mirror;
 private int _fontSize=36;
 private string _status="Ready";
 private DotNetObjectReference<Home>? _reference;
 protected override void OnInitialized()=>_tracker.Load(_script);
 protected override void OnAfterRender(bool firstRender)
 {
   if(firstRender) _reference=DotNetObjectReference.Create(this);
 }
 private async Task Toggle()
 {
   if(_running){await JS.InvokeVoidAsync("videoPrompter.stop");_running=false;_status="Stopped";}
   else {try{await JS.InvokeVoidAsync("videoPrompter.start",_reference);_running=true;_editing=false;_status="Listening";}catch(Exception ex){_status=ex.Message;}}
 }
 private void ApplyScript(){_tracker.Load(_script);_editing=false;}
 private async Task Reset(){_tracker.Seek(0);await JS.InvokeVoidAsync("videoPrompter.scrollTo",0);}
 private async Task Seek(int i){_tracker.Seek(i);await JS.InvokeVoidAsync("videoPrompter.scrollTo",i);}
 [JSInvokable]
 public async Task OnTranscript(string text,bool isFinal)
 {
   if(!_running)return;
   _tracker.Match(text);
   _status=isFinal?"Listening": "Recognizing";
   await InvokeAsync(StateHasChanged);
   await JS.InvokeVoidAsync("videoPrompter.scrollTo",_tracker.Position);
 }
 [JSInvokable]
 public Task OnStatus(string text){_status=text;return InvokeAsync(StateHasChanged);}
 public async ValueTask DisposeAsync(){try{await JS.InvokeVoidAsync("videoPrompter.stop");}catch(JSDisconnectedException){} _reference?.Dispose();}
}